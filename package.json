{
	"name": "@openaq/transform",
	"description": "Transform air quality data sources to a single standardized output",
	"author": "OpenAQ <dev@openaq.org> (https://openaq.org)",
	"contributors": [
		"Russ Biggs <russ@openaq.org>",
		"Christian Parker <chris@talloaks.io>",
		"Jacob Fenton <jacob@openaq.org>"
	],
	"version": "0.6.2",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/openaq/openaq-transform.git"
	},
	"type": "module",
	"packageManager": "pnpm@10.30.3",
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"sideEffects": false,
	"exports": {
		"./core": {
			"types": "./dist/core/index.d.mts",
			"default": "./dist/core/index.mjs"
		},
		"./node": {
			"types": "./dist/node/index.d.mts",
			"default": "./dist/node/index.mjs"
		},
		"./browser": {
			"types": "./dist/browser/index.d.mts",
			"default": "./dist/browser/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"build:core": "tsdown --config tsdown.core.config.ts",
		"build:platforms": "tsdown --config tsdown.platforms.config.ts",
		"dev": "tsdown --watch",
		"fix": "pnpm run format && pnpm run lint",
		"format": "biome check --write .",
		"format:check": "biome check .",
		"lint": "biome lint --write .",
		"lint:check": "biome lint .",
		"test": "vitest run --typecheck",
		"test:watch": "vitest --typecheck",
		"coverage": "vitest run --typecheck --coverage",
		"type-check": "tsc --noEmit",
		"type-check:watch": "tsc --noEmit --watch",
		"knip": "knip"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.12",
		"@types/debug": "^4.1.12",
		"@types/node": "^24.0.1",
		"@types/proj4": "^2.5.6",
		"@vitest/coverage-v8": "^3.2.4",
		"fast-check": "^4.9.0",
		"happy-dom": "^17.4.6",
		"knip": "^5.85.0",
		"msw": "^2.7.5",
		"tsdown": "^0.22.3",
		"typescript": "~5.8.3",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"@jmespath-community/jmespath": "^1.3.0",
		"@types/geojson": "^7946.0.16",
		"@types/luxon": "^3.7.4",
		"csv-parse": "^5.6.0",
		"fast-xml-parser": "^5.5.9",
		"luxon": "^3.6.1",
		"obug": "^2.1.3",
		"proj4": "^2.15.0"
	}
}
